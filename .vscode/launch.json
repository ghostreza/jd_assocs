{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run J&D Flask App",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "main",
                "run",
                "--no-debugger",
                "--no-reload",
                "--host",
                "127.0.0.1",
                "--port",
                "5000"
            ],
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "justMyCode": true
        }
    ]
}
